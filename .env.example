# --- OpenRouter ---
AI_API=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Ustaw miesieczny limit wydatkow bezposrednio na kluczu w panelu OpenRoutera:
# https://openrouter.ai/settings/keys -> edytuj klucz -> "Credit limit" + "Reset: monthly"

# Prog ostrzegawczy (procent miesiecznego limitu), po ktorym orchestrator
# wysyla powiadomienie na WhatsApp
COST_ALERT_THRESHOLD=0.8

# --- GitHub (repozytorium produkowanej aplikacji Android) ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=twoj-user/nazwa-repo-android
GITHUB_DEFAULT_BRANCH=main

# --- Komunikacja wewnetrzna orchestrator <-> most WhatsApp ---
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3000

# --- Numer/JID WhatsApp, ktory ma prawo wydawac zadania (bezpieczenstwo) ---
ALLOWED_WHATSAPP_JID=48xxxxxxxxx@s.whatsapp.net

# --- Sciezka lokalna, gdzie klonowane jest repo aplikacji Android ---
ANDROID_REPO_PATH=/home/agent/android-app

# --- Limity petli weryfikacji ---
MAX_RETRIES=3
