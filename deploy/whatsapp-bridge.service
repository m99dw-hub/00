[Unit]
Description=WhatsApp Bridge (Baileys)
After=network.target orchestrator.service
Wants=orchestrator.service

[Service]
Type=simple
User=agent
WorkingDirectory=/home/agent/android-agent-system/whatsapp-bridge
EnvironmentFile=/home/agent/android-agent-system/.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
